<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Lock files make restores reproducible; CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <Version>0.1.0</Version>
    <Authors>vjymisal0</Authors>
    <Product>Pulse Bar</Product>
    <Copyright>Copyright (c) 2026 vjymisal0</Copyright>
    <RepositoryUrl>https://github.com/vjymisal0/pulse-bar-windows</RepositoryUrl>
  </PropertyGroup>
</Project>
