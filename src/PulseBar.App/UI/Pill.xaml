<UserControl x:Class="PulseBar.App.UI.Pill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border CornerRadius="9" Padding="7,1" Margin="2,0" Background="{DynamicResource PillBackground}">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="NameText" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource BarDim}" Margin="0,0,6,0" />
      <TextBlock x:Name="ValueText" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="ExtraText" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>
  </Border>
</UserControl>
