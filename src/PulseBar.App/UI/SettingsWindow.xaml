<Window x:Class="PulseBar.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PulseBar.Core;assembly=PulseBar.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Pulse Bar settings" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FlyoutBackground}" Foreground="{DynamicResource FlyoutText}">
  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="{DynamicResource FlyoutDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <ObjectDataProvider x:Key="DockModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="core:DockMode" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="TempUnits" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="core:TempUnit" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>

  <StackPanel Margin="20,6,20,20">
    <TextBlock Text="Show on the bar" Style="{StaticResource Heading}" />
    <TextBlock Text="The click-open panel always shows everything." Style="{StaticResource Hint}" />
    <CheckBox Content="CPU usage" IsChecked="{Binding ShowCpu}" />
    <CheckBox Content="GPU usage" IsChecked="{Binding ShowGpu}" />
    <CheckBox Content="RAM used" IsChecked="{Binding ShowRam}" />
    <CheckBox Content="CPU and GPU temperatures" IsChecked="{Binding ShowTemps}" />
    <CheckBox Content="Network speed" IsChecked="{Binding ShowNet}" />

    <TextBlock Text="Position" Style="{StaticResource Heading}" />
    <ComboBox ItemsSource="{Binding Source={StaticResource DockModes}}" SelectedItem="{Binding Dock}" />
    <TextBlock Text="Gap from the notification area (pixels), if the bar overlaps other icons:" Style="{StaticResource Hint}" Margin="0,8,0,2" />
    <TextBox Text="{Binding TaskbarOffset}" />

    <TextBlock Text="Refresh" Style="{StaticResource Heading}" />
    <TextBlock Text="Milliseconds between updates (500–10000). Higher uses less power." Style="{StaticResource Hint}" />
    <TextBox Text="{Binding RefreshMs}" />

    <TextBlock Text="Temperatures" Style="{StaticResource Heading}" />
    <ComboBox ItemsSource="{Binding Source={StaticResource TempUnits}}" SelectedItem="{Binding TempUnit}" />
    <TextBlock Text="Yellow from / red from (°C, whatever unit is shown):" Style="{StaticResource Hint}" Margin="0,8,0,2" />
    <StackPanel Orientation="Horizontal">
      <TextBox Text="{Binding TempWarn}" Width="60" />
      <TextBox Text="{Binding TempCrit}" Width="60" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Width="80" IsCancel="True" />
      <Button Content="Save" Width="80" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
